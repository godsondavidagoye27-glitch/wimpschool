# WimpSchool environment configuration
# Browser-safe keys (generated into js/config.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X

# Server-only secret: do not expose in browser code or commit to git
SUPER_ADMIN_SECRET=super-secret-key

# Notification delivery placeholders
SENDGRID_API_KEY=your-sendgrid-api-key
NOTIFICATION_FROM_EMAIL=hello@yourdomain.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+15551234567
